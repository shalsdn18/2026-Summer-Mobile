<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F6">

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- 상단 자산 요약 섹션 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="내 투자"
                    android:textColor="#4E5968"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalInvestment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#191F28"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    tools:text="7,211,054원" />

                <TextView
                    android:id="@+id/tvTotalProfitLoss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F04452"
                    android:textSize="15sp"
                    android:layout_marginTop="2dp"
                    tools:text="+1,595,216원 (28.4%)" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="대기 주문"
                            android:textColor="#8B95A1"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvPendingOrdersBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#191F28"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="해외주식 50건" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="원화 예수금"
                            android:textColor="#8B95A1"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvKrwCashBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#191F28"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="1,842,302원" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="달러 예수금"
                            android:textColor="#8B95A1"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvUsdCashBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#191F28"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="$1,042.50" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 국내 주식 목록 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="국내 주식"
                    android:textColor="#8B95A1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDomesticStocks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_holding_stock" />
            </LinearLayout>

            <!-- 해외 주식 목록 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="해외 주식"
                    android:textColor="#8B95A1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvOverseasStocks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_holding_stock" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>