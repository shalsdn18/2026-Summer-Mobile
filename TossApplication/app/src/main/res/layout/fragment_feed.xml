<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 1. 부드러운 스크롤 콘텐츠 스트림 영역 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/feedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:paddingBottom="90dp"> <!-- 하단 네비바 및 FAB 가림 방지 버퍼 -->

            <!-- ================= TOP HEADER ================= -->
            <TextView
                android:id="@+id/tvFeedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="피드"
                android:textColor="#191F28"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvFeedSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="러셀 2000 선물 3,002.00 -0.2%"
                android:textColor="#3182F6"
                android:textSize="13sp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@id/tvFeedTitle"
                app:layout_constraintStart_toEndOf="@id/tvFeedTitle" />

            <!-- ================= SUB TABS SYSTEM ================= -->
            <LinearLayout
                android:id="@+id/layoutFeedTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/tvFeedTitle">
                <Button style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_width="wrap_content" android:layout_height="38dp" android:text="전체" android:backgroundTint="#F2F4F6" android:textColor="#191F28" android:layout_marginEnd="8dp" app:cornerRadius="10dp"/>
                <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="38dp" android:text="팔로잉" android:textColor="#8B95A1" android:layout_marginEnd="8dp"/>
                <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="38dp" android:text="뉴스" android:textColor="#8B95A1" android:layout_marginEnd="8dp"/>
                <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="38dp" android:text="콘텐츠" android:textColor="#8B95A1"/>
            </LinearLayout>

            <!-- ================= FEED CARD: KATOO POST ================= -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardFeedPost1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/layoutFeedTabs">

                <!-- 프로필 헤더 -->
                <View
                    android:id="@+id/imgProfile1"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="#1A4E5968"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvProfileName1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Katoo"
                    android:textColor="#191F28"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp"
                    app:layout_constraintTop_toTopOf="@id/imgProfile1"
                    app:layout_constraintStart_toEndOf="@id/imgProfile1"/>

                <TextView
                    android:id="@+id/tvPostTime1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15시간 전"
                    android:textColor="#8B95A1"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/imgProfile1"
                    app:layout_constraintStart_toStartOf="@id/tvProfileName1"/>

                <TextView
                    android:id="@+id/btnFollow1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="팔로우"
                    android:textColor="#3182F6"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/imgProfile1"
                    app:layout_constraintBottom_toBottomOf="@id/imgProfile1"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- 본문 텍스트 스트림 명세 명세 -->
                <TextView
                    android:id="@+id/tvPostContent1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="단독 - 메타 컴퓨팅 용량 2배 확대 위해 9월에 자체 AI칩 양산\n\n자체 칩 Iris(MTIA 400) TSMC 생산, 브로드컴 설계\n\n컴퓨팅 용량 '27년 14GW로 2배 확대(최대 $1,450억 지출)\n\n유출메모에 의하면 삼성전자, 샌디스크 등과 장기 다년 계약\n\n(뉴스 링크는 댓글에)"
                    android:textColor="#191F28"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.3"
                    app:layout_constraintTop_toBottomOf="@id/imgProfile1"/>

                <!-- 첨부 이미지 캔버스 -->
                <View
                    android:id="@+id/viewPostImage1"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="14dp"
                    android:background="#1A3182F6"
                    app:layout_constraintTop_toBottomOf="@id/tvPostContent1"/>

                <!-- 하단 소셜 인터랙션 카운터 세트 -->
                <LinearLayout
                    android:id="@+id/layoutInteractions1"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@id/viewPostImage1">
                    <TextView android:id="@+id/tvLikeCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♥ 71" android:textColor="#4E5968" android:textSize="14sp" android:layout_marginEnd="20dp"/>
                    <TextView android:id="@+id/tvCommentCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💬 11" android:textColor="#4E5968" android:textSize="14sp" android:layout_marginEnd="20dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔁 5" android:textColor="#4E5968" android:textSize="14sp"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ================= FEED CARD 2: SAMHAHYUN POST ================= -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardFeedPost2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/cardFeedPost1">
                <View android:id="@+id/imgProfile2" android:layout_width="40dp" android:layout_height="40dp" android:background="#1AF04452" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                <TextView android:id="@+id/tvProfileName2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="삼하현 1억대 자산가 〉 삼성전자" android:textColor="#191F28" android:textSize="15sp" android:textStyle="bold" android:layout_marginStart="12dp" app:layout_constraintTop_toTopOf="@id/imgProfile2" app:layout_constraintStart_toEndOf="@id/imgProfile2"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3시간 전(수정됨)" android:textColor="#8B95A1" android:textSize="12sp" app:layout_constraintBottom_toBottomOf="@id/imgProfile2" app:layout_constraintStart_toStartOf="@id/tvProfileName2"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 2. 최하단 고정 스티키 플로팅 액션 버튼 (글쓰기 창구 +) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabWritePost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:src="@android:drawable/ic_input_add"
        app:tint="#FFFFFF"
        app:backgroundTint="#191F28"
        app:fabSize="normal"
        android:contentDescription="글쓰기"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>