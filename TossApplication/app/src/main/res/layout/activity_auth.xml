<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="24dp">

    <!-- 중앙 Toss 엠블럼 로고 이미지 -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/images"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnBiometricAuth"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.45" />

    <!-- 하단 버튼 1: 생체인식으로 잠금 해제 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBiometricAuth"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="생체인식으로 잠금 해제"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#3182F6"
        app:cornerRadius="16dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnPasswordAuth"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 하단 버튼 2: 비밀번호로 잠금 해제 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPasswordAuth"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="비밀번호로 잠금 해제"
        android:textColor="#3182F6"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#F2F4F6"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>