<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#191F28"
    android:padding="24dp">

    <!-- 상단 뒤로가기 버튼 -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#FFFFFF"
        android:contentDescription="뒤로가기"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 메인 타이틀 문구 -->
    <TextView
        android:id="@+id/tvPinTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="앱을 켜려면\n비밀번호를 눌러주세요"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 암호 입력 표시 도트 라인 -->
    <TextView
        android:id="@+id/tvPinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="○ ○ ○ ○ ＋ ○"
        android:textColor="#8B95A1"
        android:textSize="24sp"
        android:letterSpacing="0.2"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvPinTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 비밀번호를 몰라요 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnForgetPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="비밀번호를 몰라요"
        android:textColor="#F2F4F6"
        android:textSize="13sp"
        android:backgroundTint="#33E5E8EB"
        app:cornerRadius="8dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvPinDots"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ================= CUSTOM SHUFFLE KEYPAD SYSTEM ================= -->
    <!-- 이미지의 비정형 배열 완벽 동기화 (7 4 8 / 6 5 3 / 9 2 0 / 1) -->

    <!-- Row 1 -->
    <Button android:id="@+id/key7" style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp" android:layout_height="70dp" android:text="7" android:textColor="#FFFFFF" android:textSize="26sp"
        app:layout_constraintBottom_toTopOf="@id/key6" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/key4"/>
    <Button android:id="@+id/key4" style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp" android:layout_height="70dp" android:text="4" android:textColor="#FFFFFF" android:textSize="26sp"
        app:layout_constraintBottom_toTopOf="@id/key5" app:layout_constraintStart_toEndOf="@id/key7" app:layout_constraintEnd_toStartOf="@id/key8"/>
    <Button android:id="@+id/key8" style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp" android:layout_height="70dp" android:text="8" android:textColor="#FFFFFF" android:textSize="26sp"
        app:layout_constraintBottom_toTopOf="@id/key3" app:layout_constraintStart_toEndOf="@id/key4" app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Row 2 -->
    <Button android:id="@+id/key6" style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp" android:layout_height="70dp" android:text="6" android:textColor="#FFFFFF" android:textSize="26sp"
        app:layout_constraintBottom_toTopOf="@id/key9" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/key5"/>
    <Button android:id="@+id/key5" style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp" android:layout_height="70dp" android:text="5" android:textColor="#FFFFFF" android:textSize="26sp"
        app:layout_constraintBottom_toTopOf="@id/key2" app:layout_constraintStart_toStartOf="@id/key4" app:layout_constraintEnd_toEndOf="@id/key4"/>
    <Button android:id="@+id/key3" style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp" android:layout_height="70dp" android:text="3" android:textColor="#FFFFFF" android:textSize="26sp"
        app:layout_constraintBottom_toTopOf="@id/key0" app:layout_constraintStart_toEndOf="@id/key5" app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Row 3 -->
    <Button android:id="@+id/key9" style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp" android:layout_height="70dp" android:text="9" android:textColor="#FFFFFF" android:textSize="26sp"
        app:layout_constraintBottom_toTopOf="@id/keySpace" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/key2"/>
    <Button android:id="@+id/key2" style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp" android:layout_height="70dp" android:text="2" android:textColor="#FFFFFF" android:textSize="26sp"
        app:layout_constraintBottom_toTopOf="@id/key1" app:layout_constraintStart_toEndOf="@id/key9" app:layout_constraintEnd_toStartOf="@id/key0"/>
    <Button android:id="@+id/key0" style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp" android:layout_height="70dp" android:text="0" android:textColor="#FFFFFF" android:textSize="26sp"
        app:layout_constraintBottom_toTopOf="@id/keyBack" app:layout_constraintStart_toEndOf="@id/key2" app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Row 4 -->
    <View android:id="@+id/keySpace" android:layout_width="0dp" android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/key1"/>
    <Button android:id="@+id/key1" style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp" android:layout_height="70dp" android:text="1" android:textColor="#FFFFFF" android:textSize="26sp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toEndOf="@id/keySpace" app:layout_constraintEnd_toStartOf="@id/keyBack"/>
    <Button android:id="@+id/keyBack" style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp" android:layout_height="70dp" android:text="←" android:textColor="#8B95A1" android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toEndOf="@id/key1" app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>