<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:paddingBottom="80dp">

        <!-- ================= [1] TOP HEADER ================= -->
        <TextView
            android:id="@+id/tvMainTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="토스증권"
            android:textColor="#191F28"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvKospi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="코스피 7,679.06 +5.3%"
            android:textColor="#F04452"
            android:textSize="13sp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@id/tvMainTitle"
            app:layout_constraintStart_toEndOf="@id/tvMainTitle" />

        <!-- [추가] 더보기 버튼 (Far-Right 고정) -->
        <ImageView
            android:id="@+id/btnMenuMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="더보기 메뉴"
            app:layout_constraintTop_toTopOf="@id/tvMainTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvMainTitle"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- [추가] 알림용 원형 레드닷 배지 (컴파일 안전성 확보를 위해 미니 CardView 처리) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/viewRedDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            app:cardBackgroundColor="#F04452"
            app:cardCornerRadius="3dp"
            app:cardElevation="0dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintTop_toTopOf="@id/btnMenuMore"
            app:layout_constraintEnd_toEndOf="@id/btnMenuMore" />

        <!-- [추가] 종목 검색 버튼 -->
        <ImageView
            android:id="@+id/btnMenuSearch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_search"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="종목 검색"
            app:layout_constraintTop_toTopOf="@id/tvMainTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvMainTitle"
            app:layout_constraintEnd_toStartOf="@id/btnMenuMore" />

        <!-- [추가] 제미나이 AI 비서 버튼 -->
        <ImageView
            android:id="@+id/btnMenuGemini"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@android:drawable/btn_star_big_on"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="제미나이 AI 비서"
            app:layout_constraintTop_toTopOf="@id/tvMainTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvMainTitle"
            app:layout_constraintEnd_toStartOf="@id/btnMenuSearch" />

        <!-- ================= [2] BASIC ACCOUNT TITLE ================= -->
        <TextView
            android:id="@+id/tvAccountTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ 기본계좌 ↕"
            android:textColor="#4E5968"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvMainTitle"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvAccountView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="계좌보기"
            android:textColor="#8B95A1"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/tvAccountTag"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ================= [3] HORIZONTAL ACCOUNT CARDS ================= -->
        <LinearLayout
            android:id="@+id/layoutCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvAccountTag">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#E8F4F4" app:cardCornerRadius="16dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="대기 중인 주문" android:textColor="#00838F" android:textSize="11sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="해외주식 50건" android:textColor="#00838F" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#F2F4F6" app:cardCornerRadius="16dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="원화" android:textColor="#4E5968" android:textSize="11sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1,842,302원" android:textColor="#191F28" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1"
                app:cardBackgroundColor="#F2F4F6" app:cardCornerRadius="16dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="달러" android:textColor="#4E5968" android:textSize="11sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$1,042.50" android:textColor="#191F28" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ================= [4] TOTAL ASSET SUMMARY ================= -->
        <TextView
            android:id="@+id/tvInvestmentLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="내 투자"
            android:textColor="#4E5968"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/layoutCards"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvTotalAssetValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7,211,054원 〉"
            android:textColor="#191F28"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvInvestmentLabel"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvTotalProfit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+1,595,216원 (28.4%)"
            android:textColor="#F04452"
            android:textSize="15sp"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/tvTotalAssetValue"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- ================= [5] STOCK SECTION: DOMESTIC ================= -->
        <TextView
            android:id="@+id/tvDomesticHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="국내주식"
            android:textColor="#8B95A1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="36dp"
            app:layout_constraintTop_toBottomOf="@id/tvTotalProfit"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/itemSamsung"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvDomesticHeader">
            <View android:id="@+id/iconSamsung" android:layout_width="40dp" android:layout_height="40dp" android:background="#1A3182F6" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"/>
            <TextView android:id="@+id/nameSamsung" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="삼성전자" android:textColor="#191F28" android:textSize="16sp" android:textStyle="bold" android:layout_marginStart="12dp" app:layout_constraintTop_toTopOf="@id/iconSamsung" app:layout_constraintStart_toEndOf="@id/iconSamsung"/>
            <TextView android:id="@+id/countSamsung" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2주" android:textColor="#8B95A1" android:textSize="13sp" app:layout_constraintBottom_toBottomOf="@id/iconSamsung" app:layout_constraintStart_toStartOf="@id/nameSamsung"/>
            <TextView android:id="@+id/priceSamsung" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="582,000원" android:textColor="#191F28" android:textSize="16sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="@id/iconSamsung" app:layout_constraintEnd_toEndOf="parent"/>
            <TextView android:id="@+id/profitSamsung" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+445,700원 (326.9%)" android:textColor="#F04452" android:textSize="13sp" app:layout_constraintBottom_toBottomOf="@id/iconSamsung" app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/itemHyundai"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:layout_constraintTop_toBottomOf="@id/itemSamsung">
            <View android:id="@+id/iconHyundai" android:layout_width="40dp" android:layout_height="40dp" android:background="#1A00C853" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"/>
            <TextView android:id="@+id/nameHyundai" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="현대무벡스" android:textColor="#191F28" android:textSize="16sp" android:textStyle="bold" android:layout_marginStart="12dp" app:layout_constraintTop_toTopOf="@id/iconHyundai" app:layout_constraintStart_toEndOf="@id/iconHyundai"/>
            <TextView android:id="@+id/countHyundai" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1주" android:textColor="#8B95A1" android:textSize="13sp" app:layout_constraintBottom_toBottomOf="@id/iconHyundai" app:layout_constraintStart_toStartOf="@id/nameHyundai"/>
            <TextView android:id="@+id/priceHyundai" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="23,900원" android:textColor="#191F28" android:textSize="16sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="@id/iconHyundai" app:layout_constraintEnd_toEndOf="parent"/>
            <TextView android:id="@+id/profitHyundai" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+7,770원 (48.1%)" android:textColor="#F04452" android:textSize="13sp" app:layout_constraintBottom_toBottomOf="@id/iconHyundai" app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- ================= [추가 6] STOCK SECTION: FOREIGN ================= -->
        <TextView
            android:id="@+id/tvForeignHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="해외주식"
            android:textColor="#8B95A1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/itemHyundai"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 해외 1: 마이크론 테크놀로지 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/itemMicron"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvForeignHeader">
            <View android:id="@+id/iconMicron" android:layout_width="40dp" android:layout_height="40dp" android:background="#1A4E5968" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"/>
            <TextView android:id="@+id/nameMicron" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="마이크론 테크놀로지" android:textColor="#191F28" android:textSize="16sp" android:textStyle="bold" android:layout_marginStart="12dp" app:layout_constraintTop_toTopOf="@id/iconMicron" app:layout_constraintStart_toEndOf="@id/iconMicron"/>
            <TextView android:id="@+id/countMicron" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.281617주" android:textColor="#8B95A1" android:textSize="13sp" app:layout_constraintBottom_toBottomOf="@id/iconMicron" app:layout_constraintStart_toStartOf="@id/nameMicron"/>
            <TextView android:id="@+id/priceMicron" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="419,884원" android:textColor="#191F28" android:textSize="16sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="@id/iconMicron" app:layout_constraintEnd_toEndOf="parent"/>
            <TextView android:id="@+id/profitMicron" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+207,857원 (98.0%)" android:textColor="#F04452" android:textSize="13sp" app:layout_constraintBottom_toBottomOf="@id/iconMicron" app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 해외 2: 엔비디아 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/itemNvidia"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:layout_constraintTop_toBottomOf="@id/itemMicron">
            <View android:id="@+id/iconNvidia" android:layout_width="40dp" android:layout_height="40dp" android:background="#1A00C853" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"/>
            <TextView android:id="@+id/nameNvidia" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="엔비디아" android:textColor="#191F28" android:textSize="16sp" android:textStyle="bold" android:layout_marginStart="12dp" app:layout_constraintTop_toTopOf="@id/iconNvidia" app:layout_constraintStart_toEndOf="@id/iconNvidia"/>
            <TextView android:id="@+id/countNvidia" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3.692514주" android:textColor="#8B95A1" android:textSize="13sp" app:layout_constraintBottom_toBottomOf="@id/iconNvidia" app:layout_constraintStart_toStartOf="@id/nameNvidia"/>
            <TextView android:id="@+id/priceNvidia" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1,126,574원" android:textColor="#191F28" android:textSize="16sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="@id/iconNvidia" app:layout_constraintEnd_toEndOf="parent"/>
            <TextView android:id="@+id/profitNvidia" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+420,715원 (59.6%)" android:textColor="#F04452" android:textSize="13sp" app:layout_constraintBottom_toBottomOf="@id/iconNvidia" app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- ================= [추가 7] ANALYSIS SUMMARY LAYER ================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAnalysis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="#F2F4F6"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/itemNvidia">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="주문내역" android:textColor="#4E5968" android:textSize="15sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="이번 달 906건 〉" android:textColor="#191F28" android:textSize="15sp" android:layout_alignParentEnd="true" android:textStyle="bold"/>
                </RelativeLayout>
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="판매수익" android:textColor="#4E5968" android:textSize="15sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="이번 달 +111,347원 〉" android:textColor="#F04452" android:textSize="15sp" android:layout_alignParentEnd="true" android:textStyle="bold"/>
                </RelativeLayout>
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="배당금" android:textColor="#4E5968" android:textSize="15sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="이번 달 969원 〉" android:textColor="#191F28" android:textSize="15sp" android:layout_alignParentEnd="true" android:textStyle="bold"/>
                </RelativeLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E8EB" android:layout_marginVertical="12dp"/>
                <TextView android:id="@+id/tvAnalysisLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="수익분석 〉" android:textColor="#4E5968" android:textSize="15sp" android:gravity="center" android:textStyle="bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- ================= [추가 8] PERSONALIZED SERVICE LIST ================= -->
        <TextView
            android:id="@+id/tvServiceHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="노민우님을 위한 맞춤형 서비스"
            android:textColor="#191F28"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="36dp"
            app:layout_constraintTop_toBottomOf="@id/cardAnalysis"
            app:layout_constraintStart_toStartOf="parent"/>

        <LinearLayout
            android:id="@+id/layoutServices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvServiceHeader">
            <TextView android:layout_width="match_parent" android:layout_height="50dp" android:text="💰 세금 아끼는 ISA계좌 보러가기 〉" android:textColor="#4E5968" android:textSize="15sp" android:gravity="center_vertical"/>
            <TextView android:layout_width="match_parent" android:layout_height="50dp" android:text="📅 출석체크하고 적립금 받기 〉" android:textColor="#4E5968" android:textSize="15sp" android:gravity="center_vertical"/>
            <TextView android:layout_width="match_parent" android:layout_height="50dp" android:text="👶 아이 계좌 만들고 2만원 받기 〉" android:textColor="#4E5968" android:textSize="15sp" android:gravity="center_vertical"/>
            <TextView android:layout_width="match_parent" android:layout_height="50dp" android:text="✦ AI가 포착한 실시간 이슈 보기 〉" android:textColor="#4E5968" android:textSize="15sp" android:gravity="center_vertical"/>
        </LinearLayout>


        <!-- ================= [추가 9] TRANSACTION RANKING CHART ================= -->
        <TextView
            android:id="@+id/tvChartHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="실시간 거래대금 차트"
            android:textColor="#191F28"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/layoutServices"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- 랭킹 1위 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/chartItem1"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvChartHeader">
            <TextView android:id="@+id/rank1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="#191F28" android:textSize="16sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"/>
            <TextView android:id="@+id/chartName1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KODEX SK하이닉스단일종목레버리지" android:textColor="#191F28" android:textSize="15sp" android:textStyle="bold" android:layout_marginStart="20dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toEndOf="@id/rank1"/>
            <TextView android:id="@+id/chartPrice1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="22,455원 +2.3%" android:textColor="#F04452" android:textSize="13sp" app:layout_constraintTop_toBottomOf="@id/chartName1" app:layout_constraintStart_toStartOf="@id/chartName1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 랭킹 2위 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/chartItem2"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:layout_constraintTop_toBottomOf="@id/chartItem1">
            <TextView android:id="@+id/rank2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textColor="#191F28" android:textSize="16sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"/>
