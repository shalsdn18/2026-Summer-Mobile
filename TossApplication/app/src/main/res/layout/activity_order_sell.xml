<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="20dp">

    <!-- 툴바 영역 (뒤로가기 48dp 터치 영역 확보) -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_revert"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvOrderHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="삼성전자\n292,500원 +5.2%"
        android:textColor="#191F28"
        android:textSize="14sp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 판매할 가격 섹션 카드 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPriceBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="#F2F4F6"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="판매할 가격  |  현재가  |  시장가" android:textColor="#8B95A1" android:textSize="13sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="292,500원" android:textColor="#191F28" android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 수량 입력 섹션 카드 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQuantityBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#F2F4F6"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardPriceBox">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="수량" android:textColor="#8B95A1" android:textSize="13sp"/>
            <TextView android:id="@+id/tvQuantityInput" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="몇 주 판매할까요?" android:textColor="#ADB5BD" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="6dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="판매가능 최대 2주" android:textColor="#8B95A1" android:textSize="12sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 비율 조정용 칩 레이아웃 -->
    <LinearLayout
        android:id="@+id/layoutChips"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/cardQuantityBox">
        <Button style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="10%" android:textColor="#4E5968" app:cornerRadius="10dp" android:layout_marginEnd="4dp"/>
        <Button style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="25%" android:textColor="#4E5968" app:cornerRadius="10dp" android:layout_marginEnd="4dp"/>
        <Button style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="50%" android:textColor="#4E5968" app:cornerRadius="10dp" android:layout_marginEnd="4dp"/>
        <Button style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="최대" android:textColor="#4E5968" app:cornerRadius="10dp"/>
    </LinearLayout>

    <!-- 입력용 전용 하단 키패드 매핑 레이어 -->
    <GridLayout
        android:id="@+id/numericKeypad"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:columnCount="3"
        android:rowCount="4"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnOrderAction">
        <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:text="1" android:textColor="#191F28" android:textSize="20sp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:text="2" android:textColor="#191F28" android:textSize="20sp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:text="3" android:textColor="#191F28" android:textSize="20sp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:text="4" android:textColor="#191F28" android:textSize="20sp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:text="5" android:textColor="#191F28" android:textSize="20sp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:text="6" android:textColor="#191F28" android:textSize="20sp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:text="7" android:textColor="#191F28" android:textSize="20sp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:text="8" android:textColor="#191F28" android:textSize="20sp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:text="9" android:textColor="#191F28" android:textSize="20sp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:text="00" android:textColor="#191F28" android:textSize="20sp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:text="0" android:textColor="#191F28" android:textSize="20sp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:text="←" android:textColor="#8B95A1" android:textSize="20sp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
    </GridLayout>

    <!-- 하단 고정 거래 실행 기능 버튼 -->
    <Button
        android:id="@+id/btnOrderAction"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="판매하기"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#3182F6"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>