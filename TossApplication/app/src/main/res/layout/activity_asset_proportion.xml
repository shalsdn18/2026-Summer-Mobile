<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:paddingBottom="80dp"> <!-- 스크롤 가드 패딩 적용 -->

        <!-- 툴바 (터치 히트박스 48dp 확보) -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로가기"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvAccountSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="기본계좌 ▽"
            android:textColor="#4E5968"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- 헤더 및 총 금액 명세 -->
        <TextView
            android:id="@+id/tvTotalAmountLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="총 금액"
            android:textColor="#8B95A1"
            android:textSize="14sp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvTotalAmountValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7,218,575원"
            android:textColor="#191F28"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvTotalAmountLabel"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- MPAndroidChart 엔진 연동 도넛형 파이차트 -->
        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/portfolioPieChart"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvTotalAmountValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- ================= 종목별 할당 가중치 리스트 매핑 ================= -->
        <!-- 1. 엔비디아 (15.6%) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/propItem1"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/portfolioPieChart">
            <View android:id="@+id/colorTag1" android:layout_width="16dp" android:layout_height="16dp" android:background="#3182F6" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"/>
            <TextView android:id="@+id/name1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="엔비디아" android:textColor="#191F28" android:textSize="15sp" android:textStyle="bold" android:layout_marginStart="12dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toEndOf="@id/colorTag1"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1,127,629원" android:textColor="#8B95A1" android:textSize="12sp" app:layout_constraintTop_toBottomOf="@id/name1" app:layout_constraintStart_toStartOf="@id/name1"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15.6%" android:textColor="#191F28" android:textSize="15sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2. 알파벳 A (12.6%) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/propItem2"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:layout_constraintTop_toBottomOf="@id/propItem1">
            <View android:id="@+id/colorTag2" android:layout_width="16dp" android:layout_height="16dp" android:background="#00A79D" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"/>
            <TextView android:id="@+id/name2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="알파벳 A" android:textColor="#191F28" android:textSize="15sp" android:textStyle="bold" android:layout_marginStart="12dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toEndOf="@id/colorTag2"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="913,391원" android:textColor="#8B95A1" android:textSize="12sp" app:layout_constraintTop_toBottomOf="@id/name2" app:layout_constraintStart_toStartOf="@id/name2"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12.6%" android:textColor="#191F28" android:textSize="15sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 3. 삼성전자 (8.2%) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/propItem3"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:layout_constraintTop_toBottomOf="@id/propItem2">
            <View android:id="@+id/colorTag3" android:layout_width="16dp" android:layout_height="16dp" android:background="#2ecc71" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"/>
            <TextView android:id="@+id/name3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="삼성전자" android:textColor="#191F28" android:textSize="15sp" android:textStyle="bold" android:layout_marginStart="12dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toEndOf="@id/colorTag3"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="593,000원" android:textColor="#8B95A1" android:textSize="12sp" app:layout_constraintTop_toBottomOf="@id/name3" app:layout_constraintStart_toStartOf="@id/name3"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8.2%" android:textColor="#191F28" android:textSize="15sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 4. 마이크론 테크놀로지 (5.8%) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/propItem4"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:layout_constraintTop_toBottomOf="@id/propItem3">
            <View android:id="@+id/colorTag4" android:layout_width="16dp" android:layout_height="16dp" android:background="#f1c40f" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"/>
            <TextView android:id="@+id/name4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="마이크론 테크놀로지" android:textColor="#191F28" android:textSize="15sp" android:textStyle="bold" android:layout_marginStart="12dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toEndOf="@id/colorTag4"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="419,448원" android:textColor="#8B95A1" android:textSize="12sp" app:layout_constraintTop_toBottomOf="@id/name4" app:layout_constraintStart_toStartOf="@id/name4"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5.8%" android:textColor="#191F28" android:textSize="15sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>