<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:paddingBottom="80dp">

        <!-- ================= [1] TOP HEADER ================= -->
        <TextView
            android:id="@+id/tvWatchTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="관심"
            android:textColor="#191F28"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvWatchKospi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="코스피 7,628.88 +4.6%"
            android:textColor="#F04452"
            android:textSize="13sp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@id/tvWatchTitle"
            app:layout_constraintStart_toEndOf="@id/tvWatchTitle" />

        <!-- ================= [2] AI SIGNAL BANNER ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutAiSignal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#053182F6"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvWatchTitle">
            <TextView
                android:id="@+id/tvAiTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✦ 토스증권 AI 시그널 〉"
                android:textColor="#3182F6"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASML 홀딩... 장비수요 가시성으로 0.5% 상승"
                android:textColor="#4E5968"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/tvAiTag"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ================= [3] HORIZONTAL CHIP SYSTEM ================= -->
        <HorizontalScrollView
            android:id="@+id/scrollChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/layoutAiSignal">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_width="wrap_content" android:layout_height="38dp" android:text="최근 본" android:backgroundTint="#F2F4F6" android:textColor="#191F28" android:layout_marginEnd="6dp" app:cornerRadius="10dp"/>
                <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="38dp" android:text="확인" android:textColor="#8B95A1" android:layout_marginEnd="6dp"/>
                <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="38dp" android:text="기본" android:textColor="#8B95A1" android:layout_marginEnd="6dp"/>
                <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="38dp" android:text="짜투리" android:textColor="#8B95A1" android:layout_marginEnd="6dp"/>
                <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="38dp" android:text="레어" android:textColor="#8B95A1" android:layout_marginEnd="6dp"/>
                <Button style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="38dp" android:text="+ 그룹추가" android:textColor="#3182F6"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ================= [4] WATCH STOCK LIST ================= -->
        <TextView
            android:id="@+id/tvTableHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="표로 자세히보기 〉"
            android:textColor="#8B95A1"
            android:textSize="13sp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/scrollChips"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Item 1: Samsung -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/watchItem1"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTableHeader">
            <View android:id="@+id/imgStock1" android:layout_width="36dp" android:layout_height="36dp" android:background="#1A3182F6" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"/>
            <TextView android:id="@+id/nameStock1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="삼성전자" android:textColor="#191F28" android:textSize="15sp" android:textStyle="bold" android:layout_marginStart="12dp" app:layout_constraintTop_toTopOf="@id/imgStock1" app:layout_constraintStart_toEndOf="@id/imgStock1"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="293,500원" android:textColor="#8B95A1" android:textSize="12sp" app:layout_constraintBottom_toBottomOf="@id/imgStock1" app:layout_constraintStart_toStartOf="@id/nameStock1"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+5.5%" android:textColor="#F04452" android:textSize="15sp" android:textStyle="bold" android:layout_marginEnd="16dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@id/btnDelete1"/>
            <Button android:id="@+id/btnDelete1" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="36dp" android:layout_height="match_parent" android:text="✕" android:textColor="#ADB5BD" app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Item 2: SpaceX -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/watchItem2"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:layout_constraintTop_toBottomOf="@id/watchItem1">
            <View android:id="@+id/imgStock2" android:layout_width="36dp" android:layout_height="36dp" android:background="#1A191F28" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"/>
            <TextView android:id="@+id/nameStock2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="스페이스X" android:textColor="#191F28" android:textSize="15sp" android:textStyle="bold" android:layout_marginStart="12dp" app:layout_constraintTop_toTopOf="@id/imgStock2" app:layout_constraintStart_toEndOf="@id/imgStock2"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="228,142원" android:textColor="#8B95A1" android:textSize="12sp" app:layout_constraintBottom_toBottomOf="@id/imgStock2" app:layout_constraintStart_toStartOf="@id/nameStock2"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-0.3%" android:textColor="#3182F6" android:textSize="15sp" android:textStyle="bold" android:layout_marginEnd="16dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@id/btnDelete2"/>
            <Button android:id="@+id/btnDelete2" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="36dp" android:layout_height="match_parent" android:text="✕" android:textColor="#ADB5BD" app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- ================= [5] SECTOR RECOMMENDATION ================= -->
        <View android:id="@+id/divRecommend" android:layout_width="match_parent" android:layout_height="8dp" android:background="#F2F4F6" android:layout_marginTop="20dp" app:layout_constraintTop_toBottomOf="@id/watchItem2"/>

        <TextView
            android:id="@+id/tvRecommendHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="노민우님이 관심 있어 할\n원전 관련 주식"
            android:textColor="#191F28"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/divRecommend"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/recItem1"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvRecommendHeader">
            <TextView android:id="@+id/tvRecName1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="두산에너빌리티" android:textColor="#191F28" android:textSize="15sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="79,300원 +8.3%" android:textColor="#F04452" android:textSize="13sp" app:layout_constraintTop_toBottomOf="@id/tvRecName1" app:layout_constraintStart_toStartOf="parent"/>
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/btn_star_big_on" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- ================= [6] REALTIME NEWS FEED ================= -->
        <View android:id="@+id/divNews" android:layout_width="match_parent" android:layout_height="8dp" android:background="#F2F4F6" android:layout_marginTop="20dp" app:layout_constraintTop_toBottomOf="@id/recItem1"/>

        <TextView
            android:id="@+id/tvNewsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="최근 본 종목과 관련된 뉴스"
            android:textColor="#191F28"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/divNews"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- 뉴스 피드 행 1 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutNewsItem1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvNewsHeader"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tvNewsStockBadge1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KODEX 삼성전자채권혼합 +1.5%  삼성전자 +5.5%"
                android:textColor="#F04452"
                android:textSize="11sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tvNewsTitle1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="삼성전자 노조, 지역화폐로 성과급 지급 움직임에 반발... '개정안 철회해야'"
                android:textColor="#191F28"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvNewsStockBadge1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/imgNewsThumb1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="조선비즈 · 21분 전"
                android:textColor="#8B95A1"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/tvNewsTitle1"
                app:layout_constraintStart_toStartOf="parent"/>

            <View
                android:id="@+id/imgNewsThumb1"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="#1A8B95A1"
                app:layout_constraintTop_toTopOf="@id/tvNewsTitle1"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>