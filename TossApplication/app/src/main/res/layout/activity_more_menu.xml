<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:paddingBottom="80dp"> <!-- 하단 가림 가드 전용 패딩 주입 -->

        <!-- ================= [1] TOP TOOLBAR AREA ================= -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로가기"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/btnToolbarSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_manage"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="설정"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/btnToolbarSearch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_search"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="검색"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnToolbarSettings" />

        <!-- ================= [2] TAB SELECTOR LAYER ================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTabSelector"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#F2F4F6"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/btnBack">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="🔔 알림 🔴"
                    android:textColor="#191F28"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
                <View android:layout_width="1dp" android:layout_height="24dp" android:background="#E5E8EB"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="🎧 고객센터"
                    android:textColor="#4E5968"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= [3] QUICK MENU LIST ================= -->
        <LinearLayout
            android:id="@+id/layoutQuickMenus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="4dp"
            app:layout_constraintTop_toBottomOf="@id/cardTabSelector">
            <TextView android:layout_width="match_parent" android:layout_height="50dp" android:text="매일 적립금 받는 출석체크" android:textColor="#191F28" android:textSize="16sp" android:gravity="center_vertical"/>
            <RelativeLayout
                android:id="@+id/layoutStockAccumulateRow"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:text="주식 모으기" android:textColor="#191F28" android:textSize="16sp" android:gravity="center_vertical"/>
                <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true" android:text="76개" android:textColor="#ADB5BD" android:textSize="14sp" android:gravity="center_vertical"/>
            </RelativeLayout>
            <TextView android:layout_width="match_parent" android:layout_height="50dp" android:text="증시 캘린더" android:textColor="#191F28" android:textSize="16sp" android:gravity="center_vertical"/>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="50dp">
                <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:text="진행중인 이벤트" android:textColor="#191F28" android:textSize="16sp" android:gravity="center_vertical"/>
                <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true" android:text="3개" android:textColor="#ADB5BD" android:textSize="14sp" android:gravity="center_vertical"/>
            </RelativeLayout>
        </LinearLayout>

        <!-- ================= [4] SEC SERVICE GRID LIST ================= -->
        <View android:id="@+id/dividerMiddle" android:layout_width="match_parent" android:layout_height="1dp" android:background="#F2F4F6" android:layout_marginTop="16dp" app:layout_constraintTop_toBottomOf="@id/layoutQuickMenus"/>

        <TextView
            android:id="@+id/tvServiceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="토스증권 서비스"
            android:textColor="#8B95A1"
            android:textSize="13sp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/dividerMiddle"
            app:layout_constraintStart_toStartOf="parent"/>

        <LinearLayout
            android:id="@+id/layoutSecServices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvServiceTitle">

            <!-- 주식 -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="60dp">
                <View android:id="@+id/iconSec1" android:layout_width="36dp" android:layout_height="36dp" android:background="#1AF04452" android:layout_centerVertical="true"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/iconSec1" android:layout_marginStart="16dp" android:layout_centerVertical="true" android:text="주식  " android:textColor="#191F28" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/iconSec1" android:layout_marginStart="64dp" android:layout_centerVertical="true" android:text="조건주문 · 지정가 알림" android:textColor="#8B95A1" android:textSize="13sp"/>
            </RelativeLayout>

            <!-- 채권 -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="60dp">
                <View android:id="@+id/iconSec2" android:layout_width="36dp" android:layout_height="36dp" android:background="#1AF1C40F" android:layout_centerVertical="true"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/iconSec2" android:layout_marginStart="16dp" android:layout_centerVertical="true" android:text="채권" android:textColor="#191F28" android:textSize="16sp" android:textStyle="bold"/>
            </RelativeLayout>

            <!-- 옵션 -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="60dp">
                <View android:id="@+id/iconSec3" android:layout_width="36dp" android:layout_height="36dp" android:background="#1A9B59B6" android:layout_centerVertical="true"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/iconSec3" android:layout_marginStart="16dp" android:layout_centerVertical="true" android:text="옵션" android:textColor="#191F28" android:textSize="16sp" android:textStyle="bold"/>
            </RelativeLayout>

            <!-- 계좌 -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="60dp">
                <View android:id="@+id/iconSec4" android:layout_width="36dp" android:layout_height="36dp" android:background="#1A00C853" android:layout_centerVertical="true"/>
                <TextView android:id="@+id/tvSecLabel4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/iconSec4" android:layout_marginStart="16dp" android:layout_centerVertical="true" android:text="계좌  " android:textColor="#191F28" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/iconSec4" android:layout_marginStart="64dp" android:layout_centerVertical="true" android:text="개설 · 송금 · 환전 · 양도세" android:textColor="#8B95A1" android:textSize="13sp"/>
            </RelativeLayout>

            <!-- 인사이트 -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="60dp">
                <View android:id="@+id/iconSec5" android:layout_width="36dp" android:layout_height="36dp" android:background="#1A3498DB" android:layout_centerVertical="true"/>
                <TextView android:id="@+id/tvSecLabel5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/iconSec5" android:layout_marginStart="16dp" android:layout_centerVertical="true" android:text="인사이트  " android:textColor="#191F28" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/iconSec5" android:layout_marginStart="84dp" android:layout_centerVertical="true" android:text="토스증권 AI · 시장정보" android:textColor="#8B95A1" android:textSize="13sp"/>
            </RelativeLayout>

            <!-- 커뮤니티 -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="60dp">
                <View android:id="@+id/iconSec6" android:layout_width="36dp" android:layout_height="36dp" android:background="#1A2ECC71" android:layout_centerVertical="true"/>
                <TextView android:id="@+id/tvSecLabel6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/iconSec6" android:layout_marginStart="16dp" android:layout_centerVertical="true" android:text="커뮤니티  " android:textColor="#191F28" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/iconSec6" android:layout_marginStart="84dp" android:layout_centerVertical="true" android:text="프로필 · 주제별 커뮤니티" android:textColor="#8B95A1" android:textSize="13sp"/>
            </RelativeLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>