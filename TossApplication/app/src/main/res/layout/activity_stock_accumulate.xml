<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ================= [1] TOP TOOLBAR & TABS ================= -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_revert"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:contentDescription="뒤로가기"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/btnSettings"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="설정"
        android:textColor="#4E5968"
        android:textSize="15sp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="주식 모으기"
        android:textColor="#191F28"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"/>

    <LinearLayout
        android:id="@+id/layoutTabs"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="내 모으기" android:textColor="#191F28" android:textStyle="bold" android:textSize="16sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="주식 찾기" android:textColor="#8B95A1" android:textSize="16sp" android:gravity="center"/>
    </LinearLayout>

    <View android:id="@+id/tabIndicator" android:layout_width="120dp" android:layout_height="2dp" android:background="#191F28" app:layout_constraintTop_toBottomOf="@id/layoutTabs" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="0.18"/>
    <View android:id="@+id/tabLine" android:layout_width="match_parent" android:layout_height="1dp" android:background="#F2F4F6" app:layout_constraintTop_toBottomOf="@id/tabIndicator"/>

    <!-- ================= [2] SCROLLABLE CONTENT REGION ================= -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/tabLine"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomStickyAction">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:paddingBottom="40dp">

            <!-- 포트폴리오 섹션 -->
            <TextView android:id="@+id/lblPortfolio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="포트폴리오" android:textColor="#8B95A1" android:textSize="13sp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/itemAllWeather"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/lblPortfolio">
                <View android:id="@+id/iconPost1" android:layout_width="36dp" android:layout_height="36dp" android:background="#1A2ECC71" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                <TextView android:id="@+id/tvName1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="올웨더 포트폴리오" android:textColor="#191F28" android:textSize="15sp" android:textStyle="bold" android:layout_marginStart="12dp" app:layout_constraintTop_toTopOf="@id/iconPost1" app:layout_constraintStart_toEndOf="@id/iconPost1"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5,000원씩 · 매일" android:textColor="#8B95A1" android:textSize="12sp" app:layout_constraintBottom_toBottomOf="@id/iconPost1" app:layout_constraintStart_toStartOf="@id/tvName1"/>
                <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:text="일시정지 〉" android:textColor="#8B95A1" android:textSize="13sp" android:gravity="center_vertical" app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/itemDefensive"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                app:layout_constraintTop_toBottomOf="@id/itemAllWeather">
                <View android:id="@+id/iconPost2" android:layout_width="36dp" android:layout_height="36dp" android:background="#1A3182F6" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                <TextView android:id="@+id/tvName2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="경기방어" android:textColor="#191F28" android:textSize="15sp" android:textStyle="bold" android:layout_marginStart="12dp" app:layout_constraintTop_toTopOf="@id/iconPost2" app:layout_constraintStart_toEndOf="@id/iconPost2"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4,000원씩 · 매일" android:textColor="#8B95A1" android:textSize="12sp" app:layout_constraintBottom_toBottomOf="@id/iconPost2" app:layout_constraintStart_toStartOf="@id/tvName2"/>
                <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:text="일시정지 〉" android:textColor="#8B95A1" android:textSize="13sp" android:gravity="center_vertical" app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 개별 주식 섹션 -->
            <TextView android:id="@+id/lblStocks" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="주식" android:textColor="#8B95A1" android:textSize="13sp" android:layout_marginTop="24dp" app:layout_constraintTop_toBottomOf="@id/itemDefensive" app:layout_constraintStart_toStartOf="parent"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/itemVtwo"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/lblStocks">
                <View android:id="@+id/iconPost3" android:layout_width="36dp" android:layout_height="36dp" android:background="#1AF04452" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"/>
                <TextView android:id="@+id/tvName3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VTWO" android:textColor="#191F28" android:textSize="15sp" android:textStyle="bold" android:layout_marginStart="12dp" app:layout_constraintTop_toTopOf="@id/iconPost3" app:layout_constraintStart_toEndOf="@id/iconPost3"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1,000원씩 · 매일" android:textColor="#8B95A1" android:textSize="12sp" app:layout_constraintBottom_toBottomOf="@id/iconPost3" app:layout_constraintStart_toStartOf="@id/tvName3"/>
                <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:text="〉" android:textColor="#ADB5BD" android:textSize="16sp" android:gravity="center_vertical" app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ================= [3] BOTTOM STICKY PANEL ================= -->
    <LinearLayout
        android:id="@+id/layoutBottomStickyAction"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnPortfolioAdd"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="포트폴리오 모으기"
            android:textColor="#3182F6"
            android:textStyle="bold"
            android:backgroundTint="#E8F4F4"
            android:layout_marginEnd="8dp"
            app:cornerRadius="14dp"/>

        <Button
            android:id="@+id/btnStockAdd"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="주식 모으기"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#3182F6"
            app:cornerRadius="14dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>