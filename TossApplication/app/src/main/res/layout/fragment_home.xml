<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- ================= TOP HEADER ================= -->
        <TextView
            android:id="@+id/tvMainTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="토스증권"
            android:textColor="#191F28"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvKospi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="코스피 7,462.16 +2.9%"
            android:textColor="#F04452"
            android:textSize="13sp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@id/tvMainTitle"
            app:layout_constraintStart_toEndOf="@id/tvMainTitle" />

        <!-- ================= BASIC ACCOUNT TITLE ================= -->
        <TextView
            android:id="@+id/tvAccountTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ 기본계좌 ↕"
            android:textColor="#4E5968"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvMainTitle"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvAccountView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="계좌보기"
            android:textColor="#8B95A1"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/tvAccountTag"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ================= HORIZONTAL ACCOUNT CARDS ================= -->
        <LinearLayout
            android:id="@+id/layoutCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvAccountTag">

            <!-- Card 1: Pending Orders -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#E8F4F4"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="대기 중인 주문" android:textColor="#00838F" android:textSize="11sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="해외주식 45건" android:textColor="#00838F" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: KRW -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#F2F4F6"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="원화" android:textColor="#4E5968" android:textSize="11sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1,842,302원" android:textColor="#191F28" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: USD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#F2F4F6"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="달러" android:textColor="#4E5968" android:textSize="11sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$1,270.63" android:textColor="#191F28" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ================= TOTAL ASSET SUMMARY ================= -->
        <TextView
            android:id="@+id/tvInvestmentLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="내 투자"
            android:textColor="#4E5968"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/layoutCards"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvTotalAssetValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6,842,536원 〉"
            android:textColor="#191F28"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvInvestmentLabel"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvTotalProfit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+1,559,444원 (29.5%)"
            android:textColor="#F04452"
            android:textSize="15sp"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/tvTotalAssetValue"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- ================= STOCK SECTION: DOMESTIC ================= -->
        <TextView
            android:id="@+id/tvDomesticHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="국내주식"
            android:textColor="#8B95A1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="36dp"
            app:layout_constraintTop_toBottomOf="@id/tvTotalProfit"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Stock Item 1: Samsung Electronics -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/itemSamsung"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvDomesticHeader">

            <View
                android:id="@+id/iconSamsung"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#1A3182F6"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/nameSamsung"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="삼성전자"
                android:textColor="#191F28"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp"
                app:layout_constraintTop_toTopOf="@id/iconSamsung"
                app:layout_constraintStart_toEndOf="@id/iconSamsung"/>

            <TextView
                android:id="@+id/countSamsung"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2주"
                android:textColor="#8B95A1"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/iconSamsung"
                app:layout_constraintStart_toStartOf="@id/nameSamsung"/>

            <TextView
                android:id="@+id/priceSamsung"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="572,000원"
                android:textColor="#191F28"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/iconSamsung"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/profitSamsung"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+435,700원 (319.6%)"
                android:textColor="#F04452"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/iconSamsung"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Stock Item 2: Hyundai Movex -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/itemHyundai"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:layout_constraintTop_toBottomOf="@id/itemSamsung">

            <View
                android:id="@+id/iconHyundai"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#1A00C853"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/nameHyundai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="현대무벡스"
                android:textColor="#191F28"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp"
                app:layout_constraintTop_toTopOf="@id/iconHyundai"
                app:layout_constraintStart_toEndOf="@id/iconHyundai"/>

            <TextView
                android:id="@+id/countHyundai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1주"
                android:textColor="#8B95A1"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/iconHyundai"
                app:layout_constraintStart_toStartOf="@id/nameHyundai"/>

            <TextView
                android:id="@+id/priceHyundai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22,900원"
                android:textColor="#191F28"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/iconHyundai"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/profitHyundai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+6,770원 (41.9%)"
                android:textColor="#F04452"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/iconHyundai"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>