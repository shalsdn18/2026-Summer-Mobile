<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="64dp">

    <!-- 로고 영역 컨테이너 -->
    <FrameLayout
        android:id="@+id/layoutLogoContainer"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivStockLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImageAppearance"/>

        <!-- 이미지 로드 실패 시 나타날 토스 스타일 이니셜 텍스트 뷰 -->
        <TextView
            android:id="@+id/tvLogoInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="삼"
            tools:visibility="visible"/>
    </FrameLayout>

    <TextView
        android:id="@+id/tvStockName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#191F28"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toTopOf="@id/layoutLogoContainer"
        app:layout_constraintStart_toEndOf="@id/layoutLogoContainer"
        tools:text="삼성전자" />

    <TextView
        android:id="@+id/tvStockCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#8B95A1"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/layoutLogoContainer"
        app:layout_constraintStart_toStartOf="@id/tvStockName"
        tools:text="2주" />

    <TextView
        android:id="@+id/tvStockPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#191F28"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/layoutLogoContainer"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="582,000원" />

    <TextView
        android:id="@+id/tvStockProfit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#F04452"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/layoutLogoContainer"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="+445,700원 (326.9%)" />

</androidx.constraintlayout.widget.ConstraintLayout>